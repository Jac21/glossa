---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Glossa"
  description="Learn more about Glossa, a personal glossary of self-coined terms."
>
    <div class="about-content">
      <div class="about-card">
        <p>Attempts to capture a piece of this world.</p>
      </div>
    </div>
    <style>
      .about-content {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 2rem;
      }
      .about-card {
        background: var(--card-bg, #f5f5f5);
        border-radius: 8px;
        padding: 3rem;
        max-width: 600px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .about-card p {
        font-size: 1.2rem;
        line-height: 1.6;
        margin: 0;
      }
    </style>
</BaseLayout>
